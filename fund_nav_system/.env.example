# 阿里云企业邮箱
EMAIL_ADDRESS=datareception@ansurefo.com
EMAIL_PASSWORD=your_password_here
IMAP_SERVER=imap.qiye.aliyun.com
IMAP_PORT=993

# 数据库
DATABASE_URL=sqlite:///data/fund_nav.db

# 轮询间隔（分钟）
POLL_INTERVAL=30

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 邮件搜索回溯天数（首次运行时使用，默认 7 天）
EMAIL_LOOKBACK_DAYS=7

# 是否在处理成功后标记邮件已读（true/false）
MARK_AS_READ=false
